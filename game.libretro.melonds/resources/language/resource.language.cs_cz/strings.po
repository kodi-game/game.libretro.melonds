msgctxt "Addon Summary"
msgid "Nintendo - DS (melonDS)"
msgstr "Nintendo - DS (melonDS)"

msgctxt "Addon Description"
msgid "melonDS aims at providing fast and accurate Nintendo DS emulation."
msgstr "melonDS si klade za cíl poskytovat rychlou a přesnou emulaci Nintendo DS."

msgctxt "#30001"
msgid "Console Mode"
msgstr "Režim konzole"

msgctxt "#30002"
msgid "Boot Game Directly"
msgstr "Spustit hru přímo"

msgctxt "#30003"
msgid "Use Firmware Settings"
msgstr "Používat nastavení firmwaru"

msgctxt "#30004"
msgid "Language"
msgstr "Jazyk"

msgctxt "#30005"
msgid "Randomize MAC Address"
msgstr "Náhodně měnit MAC adresu"

msgctxt "#30006"
msgid "Enable DSi SD Card"
msgstr "Povolit SD kartu DSi"

msgctxt "#30007"
msgid "Threaded Software Renderer"
msgstr "Softwarový vykreslovač ve vláknech"

msgctxt "#30008"
msgid "OpenGL Renderer (Restart)"
msgstr "Vykreslovač OpenGL (vyžaduje restart)"

msgctxt "#30009"
msgid "OpenGL Internal Resolution"
msgstr "Interní rozlišení OpenGL"

msgctxt "#30010"
msgid "OpenGL Improved Polygon Splitting"
msgstr "Vylepšené dělení polygonů v OpenGL"

msgctxt "#30011"
msgid "OpenGL Filtering"
msgstr "Filtrování OpenGL"

msgctxt "#30012"
msgid "Microphone Input"
msgstr "Vstup mikrofonu"

msgctxt "#30013"
msgid "Audio Bitrate"
msgstr "Datový tok zvuku"

msgctxt "#30014"
msgid "Audio Interpolation"
msgstr "Interpolace zvuku"

msgctxt "#30015"
msgid "Touch Mode"
msgstr "Dotykový režim"

msgctxt "#30016"
msgid "Swap Screen Mode"
msgstr "Režim prohození obrazovek"

msgctxt "#30017"
msgid "Screen Layout"
msgstr "Rozložení obrazovek"

msgctxt "#30018"
msgid "Screen Gap"
msgstr "Mezera mezi obrazovkami"

msgctxt "#30019"
msgid "Hybrid Small Screen Mode"
msgstr "Režim malé obrazovky v hybridním rozložení"

msgctxt "#30020"
msgid "Hybrid Ratio (OpenGL Only)"
msgstr "Poměr hybridního rozložení (pouze OpenGL)"

msgctxt "#30021"
msgid "JIT Enable (Restart)"
msgstr "Povolit JIT (vyžaduje restart)"

msgctxt "#30022"
msgid "JIT Block Size"
msgstr "Velikost bloku JIT"

msgctxt "#30023"
msgid "JIT Branch Optimisations"
msgstr "Optimalizace větvení JIT"

msgctxt "#30024"
msgid "JIT Literal Optimisations"
msgstr "Optimalizace literálů JIT"

msgctxt "#30025"
msgid "JIT Fast Memory"
msgstr "Rychlá paměť JIT"

msgctxt "#30026"
msgid "System"
msgstr "Systém"

msgctxt "#30027"
msgid "Change system settings."
msgstr "Změnit nastavení systému."

msgctxt "#30028"
msgid "Choose if the core should boot the game directly or if it should boot to the DS menu instead (BIOS and firmware files required)."
msgstr "Zvolte, zda má jádro spustit hru přímo, nebo místo toho nabídku DS (vyžadují se soubory BIOSu a firmwaru)."

msgctxt "#30029"
msgid "Use language and username from the DS firmware. When disabled or if firmware file was not found, the username will be provided by the Libretro frontend, if it's empty it will default to 'melonDS'."
msgstr "Používat jazyk a uživatelské jméno z firmwaru DS. Pokud je volba zakázaná nebo nebyl nalezen soubor firmwaru, uživatelské jméno poskytne frontend Libretro; pokud je prázdné, použije se „melonDS“."

msgctxt "#30030"
msgid "Selected language will be used if 'Use Firmware Settings' is disabled or if firmware file was not found."
msgstr "Vybraný jazyk se použije, pokud je volba „Používat nastavení firmwaru“ zakázaná nebo nebyl nalezen soubor firmwaru."

msgctxt "#30031"
msgid "Video"
msgstr "Video"

msgctxt "#30032"
msgid "Change video settings."
msgstr "Změnit nastavení videa."

msgctxt "#30033"
msgid "Audio"
msgstr "Audio"

msgctxt "#30034"
msgid "Change audio settings."
msgstr "Změnit nastavení zvuku."

msgctxt "#30035"
msgid "Choose the type of noise that will be used as microphone input."
msgstr "Zvolte typ šumu, který bude použit jako vstup mikrofonu."

msgctxt "#30036"
msgid "Screen"
msgstr "Obrazovka"

msgctxt "#30037"
msgid "Change screen settings."
msgstr "Změnit nastavení obrazovky."

msgctxt "#30038"
msgid "Choose mode for interactions with the touch screen."
msgstr "Zvolte režim interakce s dotykovou obrazovkou."

msgctxt "#30039"
msgid "Choose if the 'Swap screens' button should work on press or on hold."
msgstr "Zvolte, zda má tlačítko „Prohodit obrazovky“ reagovat stisknutím, nebo podržením."

msgctxt "#30040"
msgid "Choose how many screens should be displayed and how they should be displayed."
msgstr "Zvolte, kolik obrazovek se má zobrazit a jak se mají zobrazit."

msgctxt "#30041"
msgid "Choose how large the gap between the 2 screens should be."
msgstr "Zvolte velikost mezery mezi dvěma obrazovkami."

msgctxt "#30042"
msgid "Choose the position of the small screen when using a 'hybrid' mode, or if it should show both screens."
msgstr "Zvolte polohu malé obrazovky při použití „hybridního“ režimu nebo pokud se mají zobrazit obě obrazovky."

msgctxt "#30043"
msgid "CPU Emulation"
msgstr "Emulace CPU"

msgctxt "#30044"
msgid "Change CPU emulation settings."
msgstr "Změnit nastavení emulace CPU."

msgctxt "#30045"
msgid "Linear"
msgstr "Lineární"

msgctxt "#30046"
msgid "Cosine"
msgstr "Kosinová"

msgctxt "#30047"
msgid "Cubic"
msgstr "Kubická"

msgctxt "#30048"
msgid "Mouse"
msgstr "Myš"

msgctxt "#30049"
msgid "Touch"
msgstr "Dotyk"

msgctxt "#30050"
msgid "Joystick"
msgstr "Joystick"
