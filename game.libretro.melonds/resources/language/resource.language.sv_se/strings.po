msgctxt "Addon Summary"
msgid "Nintendo - DS (melonDS)"
msgstr "Nintendo - DS (melonDS)"

msgctxt "Addon Description"
msgid "melonDS aims at providing fast and accurate Nintendo DS emulation."
msgstr "melonDS syftar till att tillhandahålla snabb och korrekt Nintendo DS-emulering."

msgctxt "#30001"
msgid "Console Mode"
msgstr "Konsolläge"

msgctxt "#30002"
msgid "Boot Game Directly"
msgstr "Starta spelet direkt"

msgctxt "#30003"
msgid "Use Firmware Settings"
msgstr "Använd firmwareinställningar"

msgctxt "#30004"
msgid "Language"
msgstr "Språk"

msgctxt "#30005"
msgid "Randomize MAC Address"
msgstr "Slumpmässig MAC-adress"

msgctxt "#30006"
msgid "Enable DSi SD Card"
msgstr "Aktivera DSi SD-kort"

msgctxt "#30007"
msgid "Threaded Software Renderer"
msgstr "Trådad programvarurenderare"

msgctxt "#30008"
msgid "OpenGL Renderer (Restart)"
msgstr "OpenGL Renderare (omstart)"

msgctxt "#30009"
msgid "OpenGL Internal Resolution"
msgstr "OpenGL intern upplösning"

msgctxt "#30010"
msgid "OpenGL Improved Polygon Splitting"
msgstr "OpenGL-förbättrad polygondelning"

msgctxt "#30011"
msgid "OpenGL Filtering"
msgstr "OpenGL-filtrering"

msgctxt "#30012"
msgid "Microphone Input"
msgstr "Mikrofoninmatning"

msgctxt "#30013"
msgid "Audio Bitrate"
msgstr "Ljudbitfrekvens"

msgctxt "#30014"
msgid "Audio Interpolation"
msgstr "Ljudinterpolering"

msgctxt "#30015"
msgid "Touch Mode"
msgstr "Pekläge"

msgctxt "#30016"
msgid "Swap Screen Mode"
msgstr "Växla skärmläge"

msgctxt "#30017"
msgid "Screen Layout"
msgstr "Skärmlayout"

msgctxt "#30018"
msgid "Screen Gap"
msgstr "Skärmmellanrum"

msgctxt "#30019"
msgid "Hybrid Small Screen Mode"
msgstr "Hybridläge för liten skärm"

msgctxt "#30020"
msgid "Hybrid Ratio (OpenGL Only)"
msgstr "Hybridförhållande (endast OpenGL)"

msgctxt "#30021"
msgid "JIT Enable (Restart)"
msgstr "Aktivera JIT (kräver omstart)"

msgctxt "#30022"
msgid "JIT Block Size"
msgstr "JIT-blockstorlek"

msgctxt "#30023"
msgid "JIT Branch Optimisations"
msgstr "JIT-optimeringar av grenar"

msgctxt "#30024"
msgid "JIT Literal Optimisations"
msgstr "JIT-optimeringar av literaler"

msgctxt "#30025"
msgid "JIT Fast Memory"
msgstr "JIT-snabbminne"

msgctxt "#30026"
msgid "System"
msgstr "System"

msgctxt "#30027"
msgid "Change system settings."
msgstr "Ändra systeminställningar."

msgctxt "#30028"
msgid "Choose if the core should boot the game directly or if it should boot to the DS menu instead (BIOS and firmware files required)."
msgstr "Välj om kärnan ska starta spelet direkt eller i stället starta till DS-menyn (BIOS- och firmwarefiler krävs)."

msgctxt "#30029"
msgid "Use language and username from the DS firmware. When disabled or if firmware file was not found, the username will be provided by the Libretro frontend, if it's empty it will default to 'melonDS'."
msgstr "Använd språk och användarnamn från DS-firmware. När det är inaktiverat eller firmwarefilen inte hittas tillhandahålls användarnamnet av Libretro-gränssnittet; om det är tomt används ”melonDS”."

msgctxt "#30030"
msgid "Selected language will be used if 'Use Firmware Settings' is disabled or if firmware file was not found."
msgstr "Det valda språket används om ”Använd firmwareinställningar” är inaktiverat eller firmwarefilen inte hittas."

msgctxt "#30031"
msgid "Video"
msgstr "Video"

msgctxt "#30032"
msgid "Change video settings."
msgstr "Ändra videoinställningar."

msgctxt "#30033"
msgid "Audio"
msgstr "Ljud"

msgctxt "#30034"
msgid "Change audio settings."
msgstr "Ändra ljudinställningar."

msgctxt "#30035"
msgid "Choose the type of noise that will be used as microphone input."
msgstr "Välj den brustyp som ska användas som mikrofoninmatning."

msgctxt "#30036"
msgid "Screen"
msgstr "Skärm"

msgctxt "#30037"
msgid "Change screen settings."
msgstr "Ändra skärminställningar."

msgctxt "#30038"
msgid "Choose mode for interactions with the touch screen."
msgstr "Välj läge för interaktion med pekskärmen."

msgctxt "#30039"
msgid "Choose if the 'Swap screens' button should work on press or on hold."
msgstr "Välj om knappen ”Växla skärmar” ska fungera vid nedtryckning eller när den hålls nedtryckt."

msgctxt "#30040"
msgid "Choose how many screens should be displayed and how they should be displayed."
msgstr "Välj hur många skärmar som ska visas och hur de ska visas."

msgctxt "#30041"
msgid "Choose how large the gap between the 2 screens should be."
msgstr "Välj hur stort mellanrummet mellan de två skärmarna ska vara."

msgctxt "#30042"
msgid "Choose the position of the small screen when using a 'hybrid' mode, or if it should show both screens."
msgstr "Välj den lilla skärmens placering i ett hybridläge, eller om båda skärmarna ska visas."

msgctxt "#30043"
msgid "CPU Emulation"
msgstr "CPU-emulering"

msgctxt "#30044"
msgid "Change CPU emulation settings."
msgstr "Ändra inställningar för CPU-emulering."

msgctxt "#30045"
msgid "Linear"
msgstr "Linjär"

msgctxt "#30046"
msgid "Cosine"
msgstr "Cosinus"

msgctxt "#30047"
msgid "Cubic"
msgstr "Kubisk"

msgctxt "#30048"
msgid "Mouse"
msgstr "Mus"

msgctxt "#30049"
msgid "Touch"
msgstr "Pekning"

msgctxt "#30050"
msgid "Joystick"
msgstr "Styrspak"

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Inställningar"
