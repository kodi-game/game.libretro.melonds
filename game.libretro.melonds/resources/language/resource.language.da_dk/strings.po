msgctxt "Addon Summary"
msgid "Nintendo - DS (melonDS)"
msgstr "Nintendo - DS (melonDS)"

msgctxt "Addon Description"
msgid "melonDS aims at providing fast and accurate Nintendo DS emulation."
msgstr "melonDS sigter mod at levere hurtig og præcis Nintendo DS-emulering."

